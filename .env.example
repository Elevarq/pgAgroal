# Runtime credentials for the compose integration stack.
#
# Copy this file to .env (gitignored) and fill in values, or export the
# variables in your shell before running docker compose. The compose file
# interpolates them fail-fast: nothing starts while they are unset, and no
# default is ever substituted (spec: compose-pgexporter-integration R2/B8).
#
# Test scripts generate ephemeral values per run via test/lib/test-env.sh —
# you only need this file for manual runs.
#
# Generate strong values, e.g.:
#   openssl rand -hex 16

# Password for the PostgreSQL test user (testuser) — also used by the
# in-stack test client.
POSTGRES_PASSWORD=

# Password for the pgexporter pg_monitor monitoring role, created at first
# database initialization by postgres-init/01-pgexporter-role.sh.
PGEXPORTER_PASSWORD=
