+static char*
+copy_param(const char* s)
+{
+   size_t n = strlen(s) + 1;
+   char* d = (char*)calloc(1, n);
+
+   if (d != NULL)
+   {
+      memcpy(d, s, n);
+   }
+   return d;
+}
+
+void
+pgagroal_copy_bounded(void* dst, size_t dstsize, const char* src)
+{
+   size_t n;
+
+   if (dst == NULL || dstsize == 0)
+   {
+      return;
+   }
+   memset(dst, 0, dstsize);
+   if (src == NULL)
+   {
+      return;
+   }
+   n = strlen(src);
+   if (n > dstsize - 1)
+   {
+      n = dstsize - 1;   /* always leave room for the NUL written by memset */
+   }
+   memcpy(dst, src, n);
+}
